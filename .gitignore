# Segredos
.env
.env.*
!.env.example

# Dados brutos (downloads grandes do IBGE/Receita)
data/raw/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Node
node_modules/
dist/
frontend/perf/results/

# Editor/SO
.vscode/
.idea/
Thumbs.db
.DS_Store

# Artefatos de testes de navegador
.playwright-mcp/

# Arquivos enviados por usuários (logos) e dumps do banco: nunca no Git (repositório público)
data/uploads/
*.dump
*.sql.gz
*.backup

# Protótipo de design (referência local, com dados demonstrativos): nunca no produto nem no repositório
design/dashboard-cinematico/
# Holograma: PNGs brutos e demonstração (27 MB). Só os WebP otimizados (frontend/public/holograma) vão para o Git.
design/holograma-360/
*.zip

# Vercel (build local e saída montada por scripts/build-vercel.mjs)
.vercel/
.vercel-out/

# Referências visuais (imagens de layout com conteúdo de exemplo): só locais
design/referencia/

# Hero 360: origem (quadros, vídeo, prévia) fora do Git; só os textos de referência. A saída otimizada fica em frontend/public/hero-360/
design/hero-360/*
!design/hero-360/LEIA-ME.txt
!design/hero-360/PROMPT-PARA-IA-VSCODE.md
