# Copie para .env e ajuste. Nunca versione o .env.
ENV=development

# Banco (Postgres + PostGIS)
POSTGRES_USER=locus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=locus

# Portas no seu Windows (troque se estiverem ocupadas)
DB_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173

# Sessão: duração em horas
SESSION_TTL_HOURS=168
