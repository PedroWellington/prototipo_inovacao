# Copie para .env e ajuste. Nunca versione o .env.

# Nome do produto: único lugar onde ele é definido (backend, frontend e títulos leem daqui).
PRODUCT_NAME=VICUS

ENV=development

# Banco (Postgres + PostGIS)
POSTGRES_USER=vicus
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vicus

# Portas no seu Windows (troque se estiverem ocupadas)
DB_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173

# Flags (GET /api/config): PROTOTYPE é interna (sem texto na tela), cadastro sem verificação de e-mail, uploads e recursos desligados
PROTOTYPE=false
DEMO_MODE=false
UPLOADS_ENABLED=true
GOOGLE_LOGIN_ENABLED=false
# Login com Google (OIDC): as três abaixo são obrigatórias para o botão aparecer; redirect = PUBLIC_BASE_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=   # produção: https://vicus-inovacao.vercel.app
PDF_ENABLED=false
# Pagamento (app/billing): false = "Comprar mais créditos" só registra interesse (tabela credit_purchase_interest)
PAYMENTS_ENABLED=false

# Assistente de IA (docs/ASSISTENTE-IA.md). Desligado ou sem chave: o botão não aparece e nada quebra.
AI_ASSISTANT_ENABLED=false
# Provedor compatível com OpenAI (/chat/completions). Chave só no servidor (Vercel > Settings > Environment
# Variables, como Secret). Nunca no frontend nem no Git.
# Google Gemini (plano gratuito do AI Studio):
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
# Alternativa antiga (Groq): usada só se AI_API_KEY estiver vazia.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_DAILY_LIMIT=30
AI_MAX_CHARS=600
AI_TIMEOUT_SECONDS=20

# Sessão: duração em horas
SESSION_TTL_HOURS=168

# Produção do protótipo: banco de dados de leitura separado (vicus-dados). Vazio = o mesmo banco das contas.
# DATA_DATABASE_URL=postgresql+psycopg://usuario:senha@host/vicus_dados?sslmode=require
